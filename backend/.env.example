# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stacksend

# Chainhooks
HIRO_API_KEY=your-hiro-api-key-here
BACKEND_URL=http://localhost:3001
WEBHOOK_SECRET=replace-with-long-random-secret

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_LINK_API_SECRET=replace-with-random-internal-secret

# Contracts
MULTISEND_CONTRACT_MAINNET=SP1234....multisend
MULTISEND_CONTRACT_TESTNET=ST1234....multisend

# Server
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
